{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ds-bot.local/schemas/code-reuse-registry.schema.json",
  "title": "DS-Bot code reuse registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotDate",
    "scope",
    "nativeSources",
    "candidates",
    "features",
    "implementationOrder",
    "verification"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "snapshotDate": {
      "type": "string",
      "format": "date"
    },
    "timeZone": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "statusMeanings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "reuseModes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nativeSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "version",
          "commit",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "implementationOrder": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "repository",
        "inspectedVersion",
        "inspectedCommit",
        "commitDate",
        "license",
        "maintained",
        "runtime",
        "sourcePaths",
        "testPaths",
        "reusableMechanisms",
        "limitations",
        "reuseMode",
        "finalDecision",
        "adoptedCode",
        "noticeRequiredNow"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "inspectedVersion": {
          "type": "string",
          "minLength": 1
        },
        "inspectedCommit": {
          "type": "string",
          "minLength": 1
        },
        "commitDate": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "maintained": {
          "type": "boolean"
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "sourcePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "testPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reusableMechanisms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reuseMode": {
          "type": "string",
          "minLength": 1
        },
        "finalDecision": {
          "type": "string",
          "minLength": 1
        },
        "adoptedCode": {
          "type": "boolean"
        },
        "noticeRequiredNow": {
          "type": "boolean"
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "existingDsBot",
        "existingDsh",
        "candidateIds",
        "reuseMode",
        "integrationCost",
        "dependencies",
        "compatibility",
        "finalDecision",
        "migration",
        "acceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "native",
            "partial",
            "missing"
          ]
        },
        "existingDsBot": {
          "type": "string",
          "minLength": 1
        },
        "existingDsh": {
          "type": "string",
          "minLength": 1
        },
        "candidateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "reuseMode": {
          "type": "string",
          "minLength": 1
        },
        "integrationCost": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "string",
          "minLength": 1
        },
        "compatibility": {
          "type": "string",
          "minLength": 1
        },
        "finalDecision": {
          "type": "string",
          "minLength": 1
        },
        "migration": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
